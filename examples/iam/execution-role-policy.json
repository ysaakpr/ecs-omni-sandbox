{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadLaunchTokensAndHarnessSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:REGION:123456789012:secret:omnigent-ecs/*",
        "arn:aws:secretsmanager:REGION:123456789012:secret:omnigent/anthropic-*"
      ]
    }
  ]
}
